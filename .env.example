# Database Configuration
DATABASE_URL=postgresql://wavyai:wavyai_password@localhost:5432/wavyai
POSTGRES_USER=wavyai
POSTGRES_PASSWORD=wavyai_password
POSTGRES_DB=wavyai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# API Keys (Optional - for enhanced AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Hugging Face Configuration
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-alpha
HUGGINGFACE_MAX_NEW_TOKENS=512

# Frontend Configuration
MAPBOX_ACCESS_TOKEN=

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=true

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
